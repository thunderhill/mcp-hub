{
  "title": "Tata Campaign AI — Pipeline",
  "uid": "torque-overview",
  "tags": ["torque"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / sec, by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(torque_http_request_duration_seconds_count[1m])) by (path, status)",
          "legendFormat": "{{path}} [{{status}}]"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "HTTP p95 latency, by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(torque_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "LLM calls / sec, by node and outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(torque_llm_calls_total[1m])) by (node, outcome)",
          "legendFormat": "{{node}} — {{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "LLM p95 latency, by node",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(torque_llm_call_duration_seconds_bucket[5m])) by (le, node))",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "description": "Opus/Sonnet-class models should never appear here — they are barred from every node's fallback chain."
    },
    {
      "id": 5,
      "title": "Compliance blocks (5m), by rule",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(torque_compliance_blocks_total[5m])) by (rule_id)",
          "legendFormat": "{{rule_id}}"
        }
      ],
      "description": "Proof the deterministic engine is actually refusing something, not a dashboard that only ever shows zero."
    },
    {
      "id": 6,
      "title": "Variants generated (5m), by status",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(torque_variants_generated_total[5m])) by (channel, status)",
          "legendFormat": "{{channel}} — {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Delivery attempts (5m), by channel and outcome",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(torque_delivery_attempts_total[5m])) by (channel, outcome)",
          "legendFormat": "{{channel}} — {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Campaign lifecycle events (5m)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(torque_campaigns_total[5m])) by (event)",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Simulator — runs / sec, by whether truth fell inside the CI",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(torque_simulator_runs_total[5m])) by (within_ci)",
          "legendFormat": "within_ci={{within_ci}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "description": "within_ci=false on a healthy pipeline means the measurement drifted from the injected ground truth, not that the campaign failed."
    },
    {
      "id": 10,
      "title": "Simulator — p95 run duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(torque_simulator_run_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "description": "Wall-clock time to sample outcomes and compute lift for one campaign — the Analytics page's loading spinner, quantified."
    }
  ]
}
