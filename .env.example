# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Hub -------------------------------------------------------------------
# 8001, not 8000: the TML backend already holds 8000 on the dev laptop.
MCP_PORT=8001
MCP_HOST=0.0.0.0
LOG_LEVEL=INFO

# Shared secret every caller must present as `Authorization: Bearer <token>`.
# Leave EMPTY to disable the check entirely — useful when first bringing the
# hub up, and a mistake to ship. /health is always exempt so a health probe
# needs no credential.
MCP_AUTH_TOKEN=

# --- Upstreams -------------------------------------------------------------
# Where MiniSlack lives. An IP, not a Docker hostname — the units run as bare
# processes across several laptops, so `http://minislack:5000` resolves
# nowhere.
MINISLACK_URL=http://127.0.0.1:5000

# --- Per-channel agent tokens ----------------------------------------------
# One MiniSlack agent token per marketing channel. MiniSlack rate-limits per
# token (30/min by default), so five tokens multiply the fan-out ceiling and
# keep each channel's traffic separately attributable upstream.
#
# Mint them in MiniSlack, one agent per outbox. A namespace with no token
# fails its own sends with a message naming the variable, and leaves the other
# four channels working.
MINISLACK_TOKEN_EMAIL=
MINISLACK_TOKEN_WHATSAPP=
MINISLACK_TOKEN_SMS=
MINISLACK_TOKEN_PUSH=
MINISLACK_TOKEN_SOCIAL=

# Operator-facing workspace tools (slack.get_channels, slack.whoami). Kept
# separate so browsing the workspace does not consume the rate budget a
# campaign fan-out needs. Falls back to MINISLACK_TOKEN_EMAIL if empty.
MINISLACK_TOKEN_OPS=

# --- Observability -----------------------------------------------------
# Provisioned by observability/setup.ps1 (Prometheus :9090, Grafana :3000 —
# portable binaries, no Docker, no admin rights). Grafana rejects
# unauthenticated API calls, so a service-account token is required for
# get_dashboards / query_prometheus / query_loki / get_alerts to work; mint
# one from Grafana's UI (Administration > Service accounts) or the API, after
# launch.ps1 brings Grafana up. Left empty, those four tools fail one call at
# a time with a clear "no Grafana API token" message rather than a mount
# failure — the same graceful-degradation pattern as a missing channel token.
OBSERVABILITY_URL=http://127.0.0.1:3000
GRAFANA_API_TOKEN=

# --- Optional upstream, disabled in config/services.yaml ---------------
RAG_URL=http://127.0.0.1:9003
